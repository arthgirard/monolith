    <string name="onboarding_select_apps_subtitle">Select the apps you want blocked.</string>
    <string name="onboarding_link_tag_subtitle">Last step: link your NFC tag to toggle blocking.</string>
    <string name="onboarding_complete_title">You\'re all set!</string>
    <string name="onboarding_complete_desc">Welcome to Monolith.</string>

