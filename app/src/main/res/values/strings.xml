<resources>
    <string name="app_name">Monolith</string>
    <string name="accessibility_service_description">Monolith uses this to detect which app is in the foreground so it can enforce blocking.</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Set up Monolith</string>
    <string name="onboarding_subtitle">Four permissions. Grant them once, forget about it.</string>
    <string name="restricted_settings_title">Toggle greyed out?</string>
    <string name="restricted_settings_body">Sideloaded apps start with Android\'s restricted settings on. Open App Info, tap ⋮ in the top corner, then \"Allow restricted settings\": the Accessibility and Notification Access toggles below will unlock.</string>
    <string name="restricted_settings_open">Open App Info</string>
    <string name="perm_usage_title">Usage Access</string>
    <string name="perm_usage_desc">Lets Monolith see which app is currently open.</string>
    <string name="perm_overlay_title">Display Over Other Apps</string>
    <string name="perm_overlay_desc">Needed to show the block screen on top of a blocked app.</string>
    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Lets Monolith detect app launches in real time and enforce blocks.</string>
    <string name="perm_notifications_title">Notification Access</string>
    <string name="perm_notifications_desc">Lets Monolith silence notifications from blocked apps while it\'s active.</string>
    <string name="perm_post_notifications_title">Post Notifications</string>
    <string name="perm_post_notifications_desc">Lets Monolith show you the notifications it held once it turns off.</string>
    <string name="perm_grant">Grant</string>
    <string name="perm_granted">Granted</string>
