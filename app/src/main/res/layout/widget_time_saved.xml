<?xml version="1.0" encoding="utf-8"?>
<!--
    Text is sized in dp rather than sp, and tools:ignore="SpUsage" covers the whole tree for it.
    Every band here is a fixed dp height that WidgetTiers reserves out of the chart's budget by
    the same number, so text that grew with the device's font-size setting would overflow a box
    that didn't: on a large-font device the stat values were clipped mid-glyph and the app labels
    lost their descenders. dp also puts this text on the same footing as the chart's hour labels,
    which TimeSavedChartRenderer already draws at a dp size because they live in a bitmap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_time_saved_label"
            android:textColor="@color/widget_muted"
            android:textSize="11dp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end" />

        <!--
            32dp box for a real tap target, with 8dp padding drawing the icon back down to the
            16dp the mark uses. The negative vertical margins cancel the extra height so the
            header stays the size TimeSavedWidgetProvider.TEXT_BAND_DP assumes, and the padding
            doubles as the gap to the label and the mark.
        -->
        <FrameLayout
            android:id="@+id/widget_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_refresh_description">

            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/widget_muted"
                android:contentDescription="@string/widget_refresh_description" />

            <!-- Takes the icon's place while a manual refresh is in flight. -->
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/widget_muted"
                android:visibility="gone" />

        </FrameLayout>

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_monolith_mark"
            android:tint="@color/widget_muted"
            android:contentDescription="@string/app_name" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_text"
        android:textSize="28dp"
        android:fontFamily="@font/inter_semibold"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/widget_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:tint="@color/widget_bar"
        android:contentDescription="@string/widget_time_saved_chart_description" />


    <!--
        The detail bands, drawn only once the widget is tall enough to hold them (see WidgetTiers).
        Their heights are fixed rather than wrap_content, and WidgetTiers reserves exactly these
        numbers out of the chart's budget: a band that measured itself would let the chart and the
        band fight over the same pixels every time a count changed width.
    -->

    <!--
        An ImageView rather than a View: RemoteViews inflates only classes carrying @RemoteView,
        and android.view.View isn't one of them.
    -->
    <ImageView
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_divider"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_stat_blocks_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_stat_blocks"
                android:textColor="@color/widget_muted"
                android:textSize="9dp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_stat_blocks_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="16dp"
                android:fontFamily="@font/inter_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_stat_held_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_stat_held"
                android:textColor="@color/widget_muted"
                android:textSize="9dp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_stat_held_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_text"
                android:textSize="16dp"
                android:fontFamily="@font/inter_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:contentDescription="@string/widget_apps_description"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_app_1"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_1_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_app_1_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_app_1_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />

            </LinearLayout>

            <!--
                This app's share of the busiest one. The bitmap is a partial fill stretched across
                the full width, so the bar's length is in the pixels rather than in a layout weight
                RemoteViews has no way to set at runtime.
            -->
            <ImageView
                android:id="@+id/widget_app_1_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:tint="@color/widget_bar"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_2"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_2_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_app_2_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_app_2_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />

            </LinearLayout>

            <!--
                This app's share of the busiest one. The bitmap is a partial fill stretched across
                the full width, so the bar's length is in the pixels rather than in a layout weight
                RemoteViews has no way to set at runtime.
            -->
            <ImageView
                android:id="@+id/widget_app_2_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:tint="@color/widget_bar"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_3"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_3_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_app_3_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_app_3_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />

            </LinearLayout>

            <!--
                This app's share of the busiest one. The bitmap is a partial fill stretched across
                the full width, so the bar's length is in the pixels rather than in a layout weight
                RemoteViews has no way to set at runtime.
            -->
            <ImageView
                android:id="@+id/widget_app_3_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:tint="@color/widget_bar"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_4"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_4_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_app_4_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_app_4_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />

            </LinearLayout>

            <ImageView
                android:id="@+id/widget_app_4_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:tint="@color/widget_bar"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_5"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_5_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_app_5_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_app_5_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />

            </LinearLayout>

            <ImageView
                android:id="@+id/widget_app_5_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:tint="@color/widget_bar"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_app_6"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_6_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_app_6_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_app_6_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11dp"
                    android:fontFamily="@font/inter_medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1" />

            </LinearLayout>

            <ImageView
                android:id="@+id/widget_app_6_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:scaleType="fitXY"
                android:tint="@color/widget_bar"
                android:importantForAccessibility="no" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
