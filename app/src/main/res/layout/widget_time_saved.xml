<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_time_saved_label"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end" />

        <!--
            32dp box for a real tap target, with 8dp padding drawing the icon back down to the
            16dp the mark uses. The negative vertical margins cancel the extra height so the
            header stays the size TimeSavedWidgetProvider.TEXT_BAND_DP assumes, and the padding
            doubles as the gap to the label and the mark.
        -->
        <FrameLayout
            android:id="@+id/widget_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_refresh_description">

            <ImageView
                android:id="@+id/widget_refresh_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                android:tint="@color/widget_muted"
                android:contentDescription="@string/widget_refresh_description" />

            <!-- Takes the icon's place while a manual refresh is in flight. -->
            <ProgressBar
                android:id="@+id/widget_refresh_progress"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/widget_muted"
                android:visibility="gone" />

        </FrameLayout>

        <ImageView
            android:id="@+id/widget_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_monolith_mark"
            android:tint="@color/widget_muted"
            android:contentDescription="@string/app_name" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_text"
        android:textSize="28sp"
        android:fontFamily="@font/inter_semibold"
        android:maxLines="1" />

    <ImageView
        android:id="@+id/widget_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:tint="@color/widget_bar"
        android:contentDescription="@string/widget_time_saved_chart_description" />

</LinearLayout>
