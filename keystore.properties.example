# Copy to keystore.properties (repo root, gitignored) and fill in.
#
# storeFile: path to your release .jks/.keystore, resolved relative to this file's directory
# (the repo root) — or an absolute path if you keep it somewhere outside the repo entirely,
# which is the safer option since a gitignored file inside the repo is still one `git add -f`
# away from getting committed by accident.
#
# Generate the keystore yourself, once, in your own terminal (not through an AI session — the
# password shouldn't end up in any chat log):
#   keytool -genkeypair -v -keystore monolith-release.jks -alias monolith \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Back this file up. Every future update you release must be signed with the SAME keystore —
# lose it and friends can never install an update over the app, only uninstall and start over.

storeFile=../monolith-release.jks
storePassword=CHANGE_ME
keyAlias=monolith
keyPassword=CHANGE_ME
